DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Genera cada secreto por separado con openssl rand -hex 32.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Obligatorio en producción. Incluye esquema y puerto si corresponde, sin barra final.
# AUTH_ORIGIN=https://cospace.san.coderhivex.com
# Habilita solo si el backend es privado y Nginx sobrescribe X-CoSpace-Client-IP.
# AUTH_TRUST_PROXY=1
# Docker Compose PostgreSQL credentials; use a hexadecimal password.
POSTGRES_DB=cospace
POSTGRES_USER=cospace
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# Private image storage. The AWS SDK uses the EC2 instance role in production.
AWS_REGION=us-east-2
AWS_S3_BUCKET=""

# Optional directory for reading existing workspace photos from disk.
# WORKSPACE_UPLOAD_DIR=/app/data/workspace-images
